# Copia este archivo como .env

# Proveedor utilizado para generar fichas: openai o gemini.
LLM_PROVIDER=openai

# Configuración de OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Configuración de Google Gemini.
# La clave se puede crear desde Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Parámetros por defecto del análisis.
DEFAULT_TOP_K=5
DEFAULT_MIN_CONFIDENCE=0.1
